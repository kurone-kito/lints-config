{
  "$schema": "https://kurone-kito.github.io/idd-skill/schemas/policy.schema.json",
  "iddVersion": "0.6.0",
  "markerPrefix": "lints-config",
  "mergePolicy": "fully_autonomous_merge",
  "reviewPolicy": "copilot-advisory",
  "threadResolutionPolicy": "fast-agent-resolve",
  "claimTiming": {
    "staleAge": "PT24H",
    "heartbeatInterval": "PT12H"
  },
  "trustedMarkerActors": ["kurone-kito"],
  "workshop": {
    "exampleRepository": ""
  },
  "commands": {
    "install-deps": "pnpm install --frozen-lockfile",
    "fix-validate": "pnpm run lint:fix && pnpm run lint",
    "pre-push-validate": "pnpm run build && pnpm run lint",
    "post-fix-validate": "pnpm run lint:fix && pnpm run build && pnpm run lint"
  },
  "helperRuntime": {
    "profile": "package-manager",
    "packageSpec": "https://codeload.github.com/kurone-kito/idd-skill/tar.gz/refs/tags/v0.6.0"
  },
  "issueScope": "roadmap-first",
  "orphanFirstPolicy": "none",
  "advisoryWait": {
    "convergenceScope": "all-prs",
    "exemptBotAuthoredPrs": true
  },
  "autopilotSuitability": {
    "floor": 3
  },
  "ciGate": {
    "trustSourcePinnedRequiredChecks": true,
    "trustEmptyProtectionReads": true
  }
}
