{
  "name": "@kurone-kito/lints-config",
  "version": "0.23.0",
  "private": true,
  "description": "My configuration for the Biome / CSpell / lint-staged and other tools",
  "keywords": [
    "biome",
    "config",
    "cspell",
    "lint-staged",
    "markdownlint"
  ],
  "homepage": "https://github.com/kurone-kito/lints-config#readme",
  "bugs": "https://github.com/kurone-kito/lints-config/issues",
  "repository": "github:kurone-kito/lints-config",
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "files": [],
  "workspaces": {
    "packages": [
      "./packages/*"
    ]
  },
  "scripts": {
    "build": "pnpm run --workspace-concurrency=0 -r build",
    "clean": "pnpm run --no-bail \"/^clean:.+/\"",
    "clean:root": "rimraf -g \"*.tgz\" \"*.tsbuildinfo\" node_modules/.cache",
    "clean:sub": "pnpm run --parallel --workspace-concurrency=0 -r clean",
    "echo": "node -e \"console.log(process.argv)\"",
    "idd:advisory-convergence": "idd-advisory-convergence",
    "idd:advisory-wait-state": "idd-advisory-wait-state",
    "idd:audit-authored-issue": "idd-audit-authored-issue",
    "idd:audit-pr-cleanup": "idd-audit-pr-cleanup",
    "idd:branch-conflict-state": "idd-branch-conflict-state",
    "idd:branch-name": "idd-branch-name",
    "idd:ci-wait-policy": "idd-ci-wait-policy",
    "idd:ci-wait-state": "idd-ci-wait-state",
    "idd:claim-approval-gate": "idd-claim-approval-gate",
    "idd:claim-lock": "idd-claim-lock",
    "idd:discover-orphan-filter": "idd-discover-orphan-filter",
    "idd:discover-readiness-check": "idd-discover-readiness-check",
    "idd:discover-roadmap-graph": "idd-discover-roadmap-graph",
    "idd:discover-shared-file-overlap": "idd-discover-shared-file-overlap",
    "idd:discover-viability-gate": "idd-discover-viability-gate",
    "idd:disposition-non-review-notices": "idd-disposition-non-review-notices",
    "idd:doctor": "idd-doctor",
    "idd:emit-marker": "idd-emit-marker",
    "idd:external-check-waiver": "idd-external-check-waiver",
    "idd:force-handoff": "idd-force-handoff",
    "idd:forced-handoff-marker": "idd-forced-handoff-marker",
    "idd:helper-bundle-manifest": "idd-helper-bundle-manifest",
    "idd:live-status-digest": "idd-live-status-digest",
    "idd:merge-execute": "idd-merge-execute",
    "idd:merged-pr-feedback-sweep": "idd-merged-pr-feedback-sweep",
    "idd:minimize-superseded-markers": "idd-minimize-superseded-markers",
    "idd:onboard": "idd-onboard",
    "idd:phase-id-resolver": "idd-phase-id-resolver",
    "idd:post-idd-marker": "idd-post-idd-marker",
    "idd:pre-merge-readiness": "idd-pre-merge-readiness",
    "idd:rerun-advisory-convergence": "idd-rerun-advisory-convergence",
    "idd:resolve-review-thread": "idd-resolve-review-thread",
    "idd:resume-claim-routing": "idd-resume-claim-routing",
    "idd:resume-route-selection": "idd-resume-route-selection",
    "idd:review-activity-snapshot": "idd-review-activity-snapshot",
    "idd:review-disposition-verify": "idd-review-disposition-verify",
    "idd:roadmap-audit-execute": "idd-roadmap-audit-execute",
    "idd:select-desynced-index": "idd-select-desynced-index",
    "idd:stalled-session-quiet-check": "idd-stalled-session-quiet-check",
    "idd:suitability-triage": "idd-suitability-triage",
    "is:prerelease": "is-prerelease $(npm pkg get version) pre",
    "is:release": "is-prerelease $(npm pkg get version)",
    "lint": "pnpm run \"/lint:.+:check/\"",
    "lint:biome-schema:check": "node scripts/check-biome-schema-pins.mjs",
    "lint:biome:check": "biome check",
    "lint:biome:fix": "biome check --write",
    "lint:cspell:check": "cspell lint --no-progress --show-suggestions -u \"./**/*\"",
    "lint:fix": "pnpm run \"/lint:.+:fix/\"",
    "lint:markdown:check": "markdownlint-cli2 \"**/*.md\"",
    "lint:markdown:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "postlint:fix": "pnpm run lint:cspell:check",
    "prepare": "husky && pnpm run build",
    "publish": "pnpm -r publish",
    "publish:next": "pnpm -r publish --tag next",
    "test": "pnpm run lint && pnpm run test:packaging",
    "test:packaging": "pnpm run test:packaging:artifacts && pnpm run test:packaging:pack",
    "test:packaging:artifacts": "node --test --test-concurrency=1 test/exports-resolution.test.mjs test/lint-staged-shape.test.mjs",
    "test:packaging:pack": "node --test --test-concurrency=1 test/pack-contents.test.mjs test/tool-integration.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@cspell/cspell-types": "^10.0.1",
    "@kurone-kito/biome-config": "workspace:^",
    "@kurone-kito/commitlint-config": "workspace:^",
    "@kurone-kito/cspell-config": "workspace:^",
    "@kurone-kito/idd-skill": "https://codeload.github.com/kurone-kito/idd-skill/tar.gz/refs/tags/v0.7.0",
    "@kurone-kito/is-prerelease": "^0.1.0",
    "@kurone-kito/lint-staged-config": "workspace:^",
    "@kurone-kito/markdownlint-config": "workspace:^",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.2",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": "^22.23.2 || ^24.2.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
