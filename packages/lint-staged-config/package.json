{
  "name": "@kurone-kito/lint-staged-config",
  "version": "0.22.0",
  "description": "My lint-staged configuration for general projects",
  "keywords": [
    "biome",
    "config",
    "cspell",
    "lint-staged"
  ],
  "homepage": "https://github.com/kurone-kito/lints-config#readme",
  "bugs": "https://github.com/kurone-kito/lints-config/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/kurone-kito/lints-config.git",
    "directory": "packages/lint-staged-config"
  },
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf -g \"*.tgz\" \"*.tsbuildinfo\" dist LICENSE",
    "prebuild": "cpy --flat ../../LICENSE .",
    "prepack": "pnpm run clean && pnpm run build",
    "start": "tsc --watch"
  },
  "devDependencies": {
    "@kurone-kito/typescript-config": "^0.22.0-alpha.9",
    "cpy-cli": "^7.0.0",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.3.x",
    "cspell": ">=8.x.x",
    "lint-staged": ">=12.1.0"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "cspell": {
      "optional": true
    },
    "lint-staged": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.23.1 || ^24.2.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
